{
  "name": "windows-12",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "."
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "sbti.christmas/windows12",
      "zone_name": "sbti.christmas"
    },
    {
      "pattern": "sbti.christmas/windows12/*",
      "zone_name": "sbti.christmas"
    }
  ],
  "previews": {},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
